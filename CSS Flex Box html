<DOCTYPE html>
    <html lang="en">

    <head>
        <title> Flexbox Demo</title>

        <style>
            .container {

                display: flex;

                flex-direction: row;

                justify-content: space-around;

                align-items: center;

                height: 200px;

                border: 3px solid purple;

                background-color: rgb(243, 212, 172);
            }

            .box {

                width: 80px;

                height: 80px;

                background-color: deeppink;

                color: white;

                font-size: 50px;

                display: flex;

                justify-content: center;

                align-items: center;
            }
        </style>

    </head>

    <body>

        <h2> Flexbox Complete Example </h2>

        <div class="container">
            <div class="box">1</div>
            <div class="box">2</div>
            <div class="box">3</div>
        </div>

    </body>

    </html>