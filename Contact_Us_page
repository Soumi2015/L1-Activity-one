<!DOCTYPE html>
<html>

<head>
    <title>Contact Us</title>
    <link rel="stylesheet" href="Contact_Us_page(css)">

</head>

<body>


    <div class="contact_container">
        <h1>Contact Us</h1>
        <p>We would greatly appreciate it if you could give us your feedback!</p>

        <form>
            <label for="name"> Full Name</label>
            <input type="text" id="name" placeholder="Please enter your full name" required>
            <br><br>

            <label for="email">Email Adress</label>
            <input type="email" id="email" placeholder="Please enter your email adress" required>
            <br><br>

            <label for="subject">Subject</label>
            <input type="text" id="subject" placeholder="Please enter the subject" required>
            <br><br>

            <label for="message">Message</label>
            <textarea id="message" rows="6" placeholder="Please write your message here..." required></textarea>

            <button type="submit">Send Message</button>

        </form>
    </div>
</body>

</html>