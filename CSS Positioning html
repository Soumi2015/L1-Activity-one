<DOCTYPE html>
    <html>

    <head>

        <style>
            div {
                right: 30px;
                border: 3px solid crimson;

            }

            div.absolute {
                position: absolute;
                left: 100px;
                border: 3px solid palevioletred;
            }

            div.relative {
                position: absolute;
                left: 100px;
                border: 3px solid rgb(178, 112, 216);
            }

            div.fixed {
                position: fixed;
                top: 0px;
                right: 20px;
                width: 300px;
                border: 3px solid gold;
            }

            div.sticky {
                position: sticky;
                top: 0px;
                right: 20px;
                width: 100px;
                border: 3px solid rgb(112, 166, 216)
            }
        </style>
    </head>

    <body>

        <h2> POSITIONING </h2>

        <div>
            Div with no position property.
        </div>

        <div class="sticky">
            Div with sticky position property.
        </div>

        <div class="relative">
            This div element has a relative position property.


            <div class="absolute">
                Div with absolute position property.
            </div>

        </div>

        <div class="fixed">
            Div with fixed position property.
        </div>

        <div style="height: 1800px; border: none;"></div>

    </body>

    </html>